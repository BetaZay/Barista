# Maintainer: Barista maintainers
pkgname=barista
pkgver=${BARISTA_VERSION:-$(head -n 1 "${BARISTA_SOURCE_DIR:-${startdir}/../..}/VERSION").0}
pkgrel=1
pkgdesc='Wii U GamePad desktop bridge'
arch=('x86_64')
license=('custom')
depends=('qt6-base' 'qt6-svg' 'networkmanager' 'polkit' 'kmod' 'iw' 'iproute2' 'openssl' 'libnl')
makedepends=('cmake' 'ninja' 'git' 'python' 'nasm' 'make' 'gcc' 'polkit')
checkdepends=('ffmpeg')
source=()
sha256sums=()
install=../linux/package-hooks.sh

# Build from a checkout. CI sets BARISTA_SOURCE_DIR explicitly; local users
# can run `cd packaging/arch && BARISTA_SOURCE_DIR="../.." makepkg -f`.
_barista_source() {
    printf '%s\n' "${BARISTA_SOURCE_DIR:-${startdir}/../..}"
}

build() {
    local source_dir
    source_dir="$(_barista_source)"
    cmake -S "$source_dir" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBARISTA_VERSION="$pkgver"
    cmake --build build --parallel
}

check() {
    ctest --test-dir build --output-on-failure --parallel 4 --timeout 180
}

package() {
    DESTDIR="$pkgdir" cmake --install build --prefix /usr
    install -Dm755 build/packaging/pre-upgrade "$pkgdir/usr/libexec/barista/package-pre-upgrade"
    install -Dm644 "$(_barista_source)/packaging/arch/barista-pre-upgrade.hook" "$pkgdir/usr/share/libalpm/hooks/barista-pre-upgrade.hook"
}

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Barista</vendor>
  <action id="org.barista.capture-session">
    <description>Capture and analyze a Barista GamePad test</description>
    <message>Authentication is required to capture Wi-Fi traffic and decrypt this local GamePad test</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@CMAKE_INSTALL_FULL_LIBEXECDIR@/barista/barista-capture-helper</annotate>
  </action>
</policyconfig>

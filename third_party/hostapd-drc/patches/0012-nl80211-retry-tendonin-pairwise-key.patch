From 1212121212121212121212121212121212121212 Mon Sep 17 00:00:00 2001
From: drc-project <drc-project@example.invalid>
Date: Thu, 3 Sep 2026 18:50:00 -0600
Subject: [PATCH] nl80211: retry Tendonin pairwise key installation

The Wii U GamePad reassociates immediately after boot and completes the
four-way handshake before some mac80211 drivers make the station available
for per-station key installation.  In that window NL80211_CMD_NEW_KEY returns
ENOENT even though hostapd has accepted the reassociation.  Retry the PTK for
a short bounded interval instead of immediately deauthenticating the GamePad.
---
 src/drivers/driver_nl80211.c | 44 ++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 44 insertions(+)

diff --git a/src/drivers/driver_nl80211.c b/src/drivers/driver_nl80211.c
index fc3cb1f..ae3b19b 100644
--- a/src/drivers/driver_nl80211.c
+++ b/src/drivers/driver_nl80211.c
@@ -3623,6 +3623,50 @@ static int wpa_driver_nl80211_set_key(struct i802_bss *bss,
 
 	ret = send_and_recv_cmd(drv, msg);
 #ifdef CONFIG_TENDONIN
+	if (ret == -ENOENT && alg != WPA_ALG_NONE &&
+	    (key_flag & KEY_FLAG_PAIRWISE) && addr &&
+	    !is_broadcast_ether_addr(addr)) {
+		static const unsigned int retry_delays_us[] = { 100000, 250000,
+			500000 };
+		u32 suite = wpa_alg_to_cipher_suite(alg, key_len);
+		size_t attempt;
+
+		for (attempt = 0;
+		     attempt < ARRAY_SIZE(retry_delays_us) && ret == -ENOENT;
+		     attempt++) {
+			struct nlattr *key_attr;
+
+			wpa_printf(MSG_DEBUG,
+				   "nl80211: Tendonin PTK not ready; retry %zu/%zu after %u us",
+				   attempt + 1, ARRAY_SIZE(retry_delays_us),
+				   retry_delays_us[attempt]);
+			os_sleep(0, retry_delays_us[attempt]);
+			msg = nl80211_ifindex_msg(drv, ifindex, 0,
+						      NL80211_CMD_NEW_KEY);
+			if (!msg)
+				break;
+			key_attr = nla_nest_start(msg, NL80211_ATTR_KEY);
+			if (!key_attr ||
+			    nla_put(msg, NL80211_KEY_DATA, key_len, key) ||
+			    nla_put_u32(msg, NL80211_KEY_CIPHER, suite) ||
+			    (seq && seq_len &&
+			     nla_put(msg, NL80211_KEY_SEQ, seq_len, seq)) ||
+			    nla_put_u8(msg, NL80211_KEY_IDX, key_idx)) {
+				nl80211_nlmsg_clear(msg);
+				nlmsg_free(msg);
+				break;
+			}
+			nla_nest_end(msg, key_attr);
+			if (nla_put(msg, NL80211_ATTR_MAC, ETH_ALEN, addr) ||
+			    (link_id != -1 &&
+			     nla_put_u8(msg, NL80211_ATTR_MLO_LINK_ID, link_id))) {
+				nl80211_nlmsg_clear(msg);
+				nlmsg_free(msg);
+				break;
+			}
+			ret = send_and_recv_cmd(drv, msg);
+		}
+	}
 	if (ret == -ENOENT && alg != WPA_ALG_NONE &&
 	    (key_flag & KEY_FLAG_GROUP)) {
 		static const unsigned int retry_delays_us[] = { 100000, 250000,

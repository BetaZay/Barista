From a4782bf7848c3500b66dc3aea815b093316024bf Mon Sep 17 00:00:00 2001
From: Barista <barista@example.invalid>
Date: Tue, 12 May 2026 19:28:53 -0600
Subject: [PATCH 1/3] hostapd: add CONFIG_TENDONIN build toggle

---
 hostapd/Makefile  | 4 ++++
 hostapd/defconfig | 3 +++
 2 files changed, 7 insertions(+)

diff --git a/hostapd/Makefile b/hostapd/Makefile
index ca44392..09c77aa 100644
--- a/hostapd/Makefile
+++ b/hostapd/Makefile
@@ -42,6 +42,10 @@ CFLAGS += -DCONFIG_TESTING_OPTIONS
 CONFIG_WPS_TESTING=y
 endif
 
+ifdef CONFIG_TENDONIN
+CFLAGS += -DCONFIG_TENDONIN
+endif
+
 ifndef CONFIG_OS
 ifdef CONFIG_NATIVE_WINDOWS
 CONFIG_OS=win32
diff --git a/hostapd/defconfig b/hostapd/defconfig
index 550db69..c963a44 100644
--- a/hostapd/defconfig
+++ b/hostapd/defconfig
@@ -120,6 +120,9 @@ CONFIG_EAP_TTLS=y
 #CONFIG_WPS_UPNP=y
 # Enable WPS support with NFC config method
 #CONFIG_WPS_NFC=y
+# Nintendo made obfuscation changes to WPS/WPA for the Wii U <-> GamePad
+# transport network. Enable this for Wii U GamePad compatibility.
+#CONFIG_TENDONIN=y
 
 # EAP-IKEv2
 #CONFIG_EAP_IKEV2=y
-- 
2.54.0


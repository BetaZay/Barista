From: Barista contributors <build@barista.invalid>
Subject: [PATCH] ap: restore bounded regulatory scan recovery on Vanilla hostapd

Port thefriendlyhedgehog's PR #3 recovery to the pinned Vanilla fork. The
fork switch dropped this patch from the build. Retry channel resolution or
mode selection once after a successful scan, retaining the original bounded
wait. A rejected scan fails without waiting or retrying. Normal successful
startup and builds without CONFIG_TENDONIN keep their existing path.

The firmware remains authoritative; this does not clear regulatory flags.

diff --git a/src/ap/hostapd.c b/src/ap/hostapd.c
--- a/src/ap/hostapd.c
+++ b/src/ap/hostapd.c
@@ -40,6 +40,9 @@
 #include "hw_features.h"
 #include "wpa_auth_glue.h"
 #include "ap_drv_ops.h"
+#ifdef CONFIG_TENDONIN
+#include "regulatory_prescan.h"
+#endif /* CONFIG_TENDONIN */
 #include "ap_config.h"
 #include "p2p_hostapd.h"
 #include "gas_serv.h"
@@ -2286,6 +2289,11 @@

 static int setup_interface2(struct hostapd_iface *iface)
 {
+#ifdef CONFIG_TENDONIN
+	int prescan_done = 0;
+
+retry_after_prescan:
+#endif /* CONFIG_TENDONIN */
-	iface->wait_channel_update = 0;
-	iface->is_no_ir = false;
+	iface->wait_channel_update = 0;
+	iface->is_no_ir = false;

@@ -2302,6 +2310,10 @@
 		iface->is_ch_switch_dfs = false;

 		ret = configured_fixed_chan_to_freq(iface);
+#ifdef CONFIG_TENDONIN
+		if (ret < 0 && hostapd_regulatory_prescan(iface, &prescan_done))
+			goto retry_after_prescan;
+#endif /* CONFIG_TENDONIN */
 		if (ret < 0)
 			goto fail;

@@ -2314,6 +2326,10 @@
 		}

 		ret = hostapd_select_hw_mode(iface);
+#ifdef CONFIG_TENDONIN
+		if (ret < 0 && hostapd_regulatory_prescan(iface, &prescan_done))
+			goto retry_after_prescan;
+#endif /* CONFIG_TENDONIN */
 		if (ret < 0) {
 			wpa_printf(MSG_ERROR, "Could not select hw_mode and "
 				   "channel. (%d)", ret);
diff --git a/src/ap/regulatory_prescan.h b/src/ap/regulatory_prescan.h
new file mode 100644
--- /dev/null
+++ b/src/ap/regulatory_prescan.h
@@ -0,0 +1,41 @@
+/*
+ * Recover channel availability after switching to AP mode.
+ * This software may be distributed under the terms of the BSD license.
+ * See README for more details.
+ */
+
+#ifndef REGULATORY_PRESCAN_H
+#define REGULATORY_PRESCAN_H
+
+/*
+ * PR #3 observed that a scan after the AP-mode switch restored channels on
+ * an AX200. Ask the driver to scan once, then re-read its channel list.
+ * This cannot override firmware restrictions or guarantee recovery.
+ * Kept in a header so the same helper can be tested with a mock driver.
+ */
+static int hostapd_regulatory_prescan(struct hostapd_iface *iface,
+				    int *prescan_done)
+{
+	struct hostapd_data *hapd = iface->bss[0];
+	struct wpa_driver_scan_params params;
+
+	if (*prescan_done || !hapd)
+		return 0;
+	*prescan_done = 1;
+	os_memset(&params, 0, sizeof(params));
+	if (hostapd_driver_scan(hapd, &params) < 0) {
+		wpa_printf(MSG_INFO,
+			   "regulatory-prescan: could not start scan");
+		return 0;
+	}
+
+	/* Retain the bounded six-second wait from the tested PR #3 workaround.
+	 * The kernel/firmware update channels independently of our event loop.
+	 * An empty SSID list requests a passive scan; do not override NO-IR. */
+	wpa_printf(MSG_INFO, "regulatory-prescan: waiting for channel update");
+	os_sleep(6, 0);
+	wpa_printf(MSG_INFO, "regulatory-prescan: rechecking channels");
+	return 1;
+}
+
+#endif /* REGULATORY_PRESCAN_H */
